# ───────── AVIORA EDU environment ─────────
# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Real Berlin in the hero (Google Photorealistic 3D Tiles). Optional — without it the built-in
# procedural Berlin is shown. In Google Cloud: enable "Map Tiles API", attach billing, and
# RESTRICT this key to your website's HTTP referrers (it is visible in the browser by design).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# WhatsApp number, WhatsApp message, business email and phone are managed in
# Admin → Business settings (stored with site content), not in environment variables.

# Social profiles — only rendered when set. Do not add accounts that do not exist.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=

# CONFIGURATION REQUIRED — admin dashboard (/admin). No default password exists.
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Content + media storage.
# VERCEL (required there — its filesystem is read-only): create a *public* Blob store
# (Vercel → Storage → Blob → Connect to project). That sets BLOB_READ_WRITE_TOKEN automatically.
# All admin content and Germany Insights photos/videos are then stored in Blob.
BLOB_READ_WRITE_TOKEN=
# LOCAL / VPS (used when BLOB_READ_WRITE_TOKEN is empty): persistent, writable directories.
CONTENT_DIR=./.data/content
UPLOAD_DIR=./.data/uploads

# Optional — email notifications for consultation requests via Resend
RESEND_API_KEY=
CONSULTATION_TO_EMAIL=
CONSULTATION_FROM_EMAIL=
