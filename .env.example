# ───────── AVIORA EDU environment ─────────
# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Real Berlin in the hero (Google Photorealistic 3D Tiles). Optional — without it the built-in
# procedural Berlin is shown. In Google Cloud: enable "Map Tiles API", attach billing, and
# RESTRICT this key to your website's HTTP referrers (it is visible in the browser by design).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Business name, email, phone, WhatsApp, address, website URL and social links are managed in
# Admin → Settings · Contact information (stored with site content). The values below are fallbacks.

# Social profiles (fallback) — only rendered when set. Do not add accounts that do not exist.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=

# CONFIGURATION REQUIRED — admin dashboard (/admin). No default password exists.
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Content + media storage (local disk driver). Must be persistent & writable.
# On serverless hosts, replace the driver in src/lib/content/store.ts with a database/object storage.
# On Vercel (read-only disk): connect "Upstash for Redis" from the Vercel Marketplace to the project.
# It sets KV_REST_API_URL and KV_REST_API_TOKEN; content and uploads are then stored in Redis instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
CONTENT_DIR=./.data/content
UPLOAD_DIR=./.data/uploads

# Optional — email notifications for consultation requests via Resend
RESEND_API_KEY=
# Optional — defaults to the business email in Admin → Settings
CONSULTATION_TO_EMAIL=
CONSULTATION_FROM_EMAIL=
